{
  "expo": {
    "name": "VMS Platform",
    "slug": "vms-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vmsplatform.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030712"
      },
      "package": "com.vmsplatform.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font"
    ],
    "scheme": "vmsplatform",
    "experiments": {
      "typedRoutes": true
    }
  }
}
